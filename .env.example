# Copy to apps/web/.env.local (Next.js) and packages/db/.env (drizzle-kit, seeds). Never commit real values.

# ── Supabase project ─────────────────────────────────────────────────────────
# Project URL and the public (anon / publishable) key from Supabase → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server only, never shipped to the browser. Used by jobs, seeds and Storage admin calls.
SUPABASE_SERVICE_ROLE_KEY=

# ── Postgres ─────────────────────────────────────────────────────────────────
# Runtime connection for the web app. Uses the RESTRICTED login `dawlyy_app` (NOINHERIT, member of
# `dawlyy_rls`) through the transaction pooler (port 6543). Every query runs inside withAuthTx() or
# withUserTx(), which do SET LOCAL ROLE dawlyy_rls, so RLS is always enforced.
DATABASE_URL=postgresql://dawlyy_app:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Privileged connection for migrations, seeds and background jobs (direct, port 5432). Bypasses RLS:
# only withServiceTx() may use it, and every query there filters by tenant_id.
DATABASE_URL_SERVICE=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
# Optional: pool size per process (positive integer, default 10). Keep processes x this under the hosted connection budget.
DAWLYY_DB_POOL_MAX=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar
# Random 32+ char secret; Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="DAWLYY <no-reply@example.com>"

# ── Web Push (VAPID) — generate with `pnpm --filter @dawlyy/web exec web-push generate-vapid-keys`
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:ops@example.com

# ── Optional integrations (off until configured) ─────────────────────────────
# Twilio Verify for WhatsApp OTP (behind FEATURE_WHATSAPP_OTP=1)
FEATURE_WHATSAPP_OTP=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Error tracking / analytics
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
