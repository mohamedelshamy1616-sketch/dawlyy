# Copy to packages/db/.env. Local cluster: tools/local_pg.ps1 (port 54329). Never commit real values.
# Privileged connection for drizzle-kit, seeds and withServiceTx (bypasses RLS).
DATABASE_URL_SERVICE=postgresql://postgres@127.0.0.1:54329/dawlyy_test
# Restricted runtime role dawlyy_app (RLS enforced through withAuthTx). On Supabase use the pooler, port 6543.
DATABASE_URL=postgresql://dawlyy_app:CHANGE_ME@127.0.0.1:54329/dawlyy_test
