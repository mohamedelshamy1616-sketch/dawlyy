# Copy to packages/db/.env for local CLI use. Never commit real values.
# Required for production
# Restricted dawlyy_app runtime connection; transaction pooler supported (prepare:false).
DATABASE_URL=
# Privileged connection for service transactions; use direct postgres connection for migrations and restore.
DATABASE_URL_SERVICE=

# Optional
# Positive integer pool maximum per process and per SQL pool; defaults to 10 in client.ts.
DAWLYY_DB_POOL_MAX=

# Local-only schema generation and QA
# Generation switch for the historical policies-off pass; always unset for migration, runtime and release.
DRIZZLE_NO_POLICIES=
