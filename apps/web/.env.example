# Copy to .env.local locally; set production values in hosting settings. Never commit secrets.
# Required for production
# Public Supabase project URL for Auth, video validation and server Storage.
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key for browser and server Auth; grants no DAWLYY Data API access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical HTTPS app origin for invitation and notification links.
NEXT_PUBLIC_APP_URL=
# Restricted dawlyy_app connection through the transaction pooler; never use postgres here.
DATABASE_URL=
# Privileged SQL connection for service jobs and bootstrap; set explicitly, never rely on runtime fallback.
DATABASE_URL_SERVICE=
# Server-only Supabase service key for signed Storage URLs; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional production features (cron is required when scheduled jobs are enabled)
# Positive integer pool size per process and per SQL pool; coordinate with the hosted connection budget.
DAWLYY_DB_POOL_MAX=
# Resend API key; email stays log-only unless this AND EMAIL_FROM are configured.
RESEND_API_KEY=
# Verified Resend sender address; separate from Supabase Auth email settings.
EMAIL_FROM=
# Public VAPID key for browser subscription and server push; needs the private key and subject.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
# Server-only VAPID private key; preserve securely so existing subscriptions remain usable.
WEB_PUSH_PRIVATE_KEY=
# VAPID contact URI (mailto or HTTPS); all three VAPID settings are needed to send push.
WEB_PUSH_SUBJECT=
# Secret accepted by cron as Bearer authorization or x-cron-secret; mandatory before enabling cron.
CRON_SECRET=

# Local-only and tooling (leave all unset in production hosting settings)
# Dev-login switch: DAWLYY_DEV_LOGIN must never be set in production.
DAWLYY_DEV_LOGIN=
# Dev-login cookie signing secret, at least 32 characters; only for isolated local QA.
DAWLYY_DEV_LOGIN_SECRET=
# Opt in to the service worker during local development; production enables it automatically.
NEXT_PUBLIC_ENABLE_SW=
# Separate Next output directory for local screenshots; production must use the default .next.
DAWLYY_DIST_DIR=
# Next/Node lifecycle mode managed by the toolchain; production builds use production, never development.
NODE_ENV=
